# ============================================================
# .gitignore — TripJoy AI Service
# ============================================================

# === SECRETS — NEVER COMMIT (CRITICAL) ===
.env
.env.*
!.env.example          

# GCP Service Account Keys — tất cả dạng JSON credentials
*.json
!package.json          
gcp-*.json
*-service-account*.json
*credentials*.json
service_account.json
application_default_credentials.json

# SSH & SSL Keys
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# === PYTHON CACHE ===
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# === VIRTUAL ENVIRONMENTS ===
.venv/
venv/
env/
ENV/
.python-version

# === TESTING & COVERAGE ===
.pytest_cache/
.coverage
htmlcov/
.tox/

# === TYPE CHECKING & LINTING ===
.mypy_cache/
.ruff_cache/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === DOCKER ===
# Không commit .env dùng với docker-compose
docker-compose.override.yml

# === LOGS ===
*.log
logs/